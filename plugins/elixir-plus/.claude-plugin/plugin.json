{
  "name": "elixir-plus",
  "version": "2.3.0",
  "description": "Elixir/Phoenix runtime capability skill with Tidewave introspection, version-aware Ash/AshOban guidance and an Oban Pro reference, plus a full or targeted codebase audit workflow for Elixir/Phoenix/LiveView/Ash projects.",
  "author": {
    "name": "Raul Gracia",
    "url": "https://github.com/raul-gracia"
  },
  "homepage": "https://github.com/raul-gracia/claude-code-elixir-plus",
  "license": "MIT",
  "keywords": [
    "elixir",
    "phoenix",
    "ash",
    "liveview",
    "ecto",
    "otp",
    "oban",
    "audit",
    "credo",
    "sobelow",
    "dialyzer"
  ],
  "lspServers": {
    "elixir-ls": {
      "command": "elixir-ls",
      "args": [],
      "extensionToLanguage": {
        ".ex": "elixir",
        ".exs": "elixir",
        ".heex": "heex",
        ".leex": "leex"
      },
      "initializationOptions": {
        "dialyzerEnabled": true,
        "fetchDeps": false,
        "suggestSpecs": true
      }
    }
  }
}
