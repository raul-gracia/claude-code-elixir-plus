{
  "name": "elixir-plus",
  "version": "1.0.1",
  "description": "Enhanced Elixir/Phoenix/Ash skills for Claude Code. Opinionated thinking skills with Iron Laws, paradigm shifts, and gotchas from the core team.",
  "author": {
    "name": "Raul Gracia",
    "url": "https://github.com/raul-gracia"
  },
  "homepage": "https://github.com/raul-gracia/claude-code-elixir-plus",
  "license": "MIT",
  "keywords": ["elixir", "phoenix", "ash", "liveview", "ecto", "otp", "oban"],
  "lspServers": {
    "elixir-ls": {
      "command": "elixir-ls",
      "args": [],
      "extensionToLanguage": {
        ".ex": "elixir",
        ".exs": "elixir",
        ".heex": "heex",
        ".leex": "leex"
      },
      "initializationOptions": {
        "dialyzerEnabled": true,
        "fetchDeps": false,
        "suggestSpecs": true
      }
    }
  }
}
